{
  "name": "@spreedly/composer-sdk-server",
  "version": "1.0.1",
  "description": "Composer Server SDK",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "umd:main": "dist/umd/index.js",
  "types": "dist/types/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:umd && npm run build:types",
    "build:cjs": "node tools/cleanup cjs && tsc -p config/tsconfig.cjs.json",
    "build:esm": "node tools/cleanup esm && tsc -p config/tsconfig.esm.json",
    "build:umd": "node tools/cleanup umd && webpack --config config/webpack.config.js",
    "build:types": "node tools/cleanup types && tsc -p config/tsconfig.types.json",
    "watch": "npm-watch",
    "link": "npm link",
    "clean": "node tools/cleanup",
    "package": "npm run build && npm pack",
    "test": "npm run build && vitest run",
    "test:cov": "npm run build && vitest run --coverage",
    "addscope": "node tools/packagejson name @spreedly/composer-sdk-server"
  },
  "watch": {
    "build": {
      "patterns": [
        "src"
      ],
      "extensions": "ts",
      "ignore": [
        "dist",
        "node_modules"
      ],
      "quite": true
    },
    "link": {
      "patterns": [
        "dist/types"
      ],
      "extensions": "ts",
      "ignore": [
        "src",
        "node_modules"
      ],
      "delay": 4000
    }
  },
  "author": "Spreedly <support@spreedly.com> (https://spreedly.com/)",
  "contributors": [],
  "bugs": {
    "url": "https://github.com/spreedly/composer-sdk-server-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spreedly/composer-sdk-server-node"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "npm-watch": "^0.13.0",
    "prettier": "^3.8.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1"
  },
  "keywords": [
    "spreedly",
    "dodgeball",
    "security",
    "trust and safety",
    "risk",
    "fraud prevention",
    "api"
  ]
}
